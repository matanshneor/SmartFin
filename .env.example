SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SECRET_KEY=your-random-secret-key-here
FLASK_ENV=development
FLASK_APP=backend.app
# Needed only for receipt scanning: a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional: see the table in the README
# RATELIMIT_STORAGE_URI=redis://localhost:6379
# RECEIPT_GLOBAL_MONTHLY_LIMIT=2000
# SENTRY_DSN=
# LOG_LEVEL=INFO
# Email to the site owner when a family signs up or someone joins (Resend)
# RESEND_API_KEY=
# OWNER_NOTIFY_EMAIL=
# CSP_REPORT_ONLY=1
# Phone notifications (backend/push.py): without these no notification is sent.
# Keys: python -c "from backend.push import generate_vapid_keys as g; print(g())"
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# The same secret as push_cron_secret in Supabase Vault
# PUSH_CRON_SECRET=

# Sign-in by phone: the same secret as login_lookup_secret in Supabase Vault.
# Without it phone sign-in doesn't work (email does).
LOGIN_LOOKUP_SECRET=
